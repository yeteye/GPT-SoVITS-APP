# ./gpt-sovits-backend/.env.example
# Flask配置
FLASK_CONFIG=development  # 开发环境
# FLASK_CONFIG=testing     # 测试环境
# FLASK_CONFIG=production  # 生产环境
SECRET_KEY=
JWT_SECRET_KEY=

# 数据库配置
DATABASE_URL=mysql+pymysql://username:password@localhost/gpt_sovits_db?charset=utf8mb4

# Redis配置
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# 文件上传配置
UPLOAD_FOLDER=./uploads
MAX_CONTENT_LENGTH=52428800  # 50MB

# 邮件配置
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# GPT-SoVITS模型路径
SOVITS_MODEL_PATH=./models/sovits
GPT_MODEL_PATH=./models/gpt

# 业务配置
MAX_CONCURRENT_TASKS=5
TASK_TIMEOUT=300
LOG_LEVEL=INFO

# API密钥（可选）
MASTER_API_KEY=your-master-api-key