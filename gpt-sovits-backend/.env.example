# ================================
# GPT-SoVITS Backend Environment Configuration
# ================================

# ================================
# Flask 应用配置
# ================================
FLASK_ENV=development
FLASK_DEBUG=true
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
SECRET_KEY=your-super-secret-key-change-in-production   # $(python -c "import secrets; print(secrets.token_urlsafe(64))")

# ================================
# 数据库配置
# ================================
# 方式1：使用 DATABASE_URL（推荐）
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/gpt_sovits_db?charset=utf8mb4

# 方式2：分离配置（备用）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=gpt_sovits_db

# 数据库连接池配置
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=20
DB_CONNECT_TIMEOUT=60
DB_READ_TIMEOUT=30
DB_WRITE_TIMEOUT=30

# ================================
# JWT 安全配置
# ================================
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production # $(python -c "import secrets; print(secrets.token_urlsafe(64))")
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# ================================
# 文件上传配置
# ================================
UPLOAD_FOLDER=./uploads
MAX_CONTENT_LENGTH=524288000  # 500MB
ALLOWED_AUDIO_EXTENSIONS=wav,mp3,flac,m4a,ogg,aac
ALLOWED_MODEL_EXTENSIONS=pth,index,json,ckpt,safetensors

# ================================
# 音频处理配置
# ================================
AUDIO_SAMPLE_RATE=22050
AUDIO_MIN_DURATION=3
AUDIO_MAX_DURATION=120

# ================================
# Redis 配置（可选）
# ================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# ================================
# Celery 配置（可选）
# ================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_RESULT_SERIALIZER=json
CELERY_TIMEZONE=Asia/Shanghai
CELERY_ENABLE_UTC=true

# ================================
# 邮件配置（可选）
# ================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-email-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# ================================
# GPT-SoVITS 模型配置
# ================================
SOVITS_MODEL_PATH=./models/sovits
GPT_MODEL_PATH=./models/gpt
MODEL_CACHE_SIZE=3
ENABLE_MODEL_PRELOAD=false

# ================================
# 业务限制配置
# ================================
MAX_CONCURRENT_TASKS=5
TASK_TIMEOUT=600
MAX_MODELS_PER_USER=20
MAX_DAILY_TASKS=100
MAX_CONCURRENT_VC_TASKS=2
MAX_CONCURRENT_TTS_TASKS=5
MAX_DAILY_VC_TASKS=10
MAX_DAILY_TTS_TASKS=50

# ================================
# 分页配置
# ================================
ITEMS_PER_PAGE=20

# ================================
# 日志配置
# ================================
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# ================================
# 系统监控配置
# ================================
ENABLE_METRICS=true
METRICS_PORT=9090

# ================================
# 安全配置
# ================================
WTF_CSRF_ENABLED=true
SESSION_COOKIE_SECURE=false  # 生产环境设为 true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
HTTPS_ENABLED=false  # 生产环境设为 true

# ================================
# 水印功能配置
# ================================
WATERMARK_ENABLED=true
WATERMARK_START_FREQ=1000
WATERMARK_DELTA=30
WATERMARK_STRENGTH=2.0
WATERMARK_BOOST=0.3
WATERMARK_ERROR_CORRECTION=true
WATERMARK_SPLIT_STRATEGY=quartile
WATERMARK_FREQ_SELECTION=prime
WATERMARK_MIN_ACCURACY=0.7
WATERMARK_FUZZY_MATCH_THRESHOLD=0.6
AUTO_WATERMARK_TTS=true
AUTO_WATERMARK_VOICE_CLONE=true
WATERMARK_CLEANUP_DAYS=90
MAX_WATERMARKS_PER_USER=10

# ================================
# 开发环境特殊配置
# ================================
# 取消注释以覆盖上述配置
# MAX_CONCURRENT_TASKS=2
# WATERMARK_START_FREQ=800
# WATERMARK_DELTA=25
# WATERMARK_STRENGTH=1.5
# WATERMARK_MIN_ACCURACY=0.5

# ================================
# API 密钥配置（可选）
# ================================
MASTER_API_KEY=your-master-api-key-for-admin-access

# ================================
# 补充缺失的环境变量配置
# 这些配置需要添加到现有的 .env.example 文件中
# ================================

# ================================
# 数据库连接池配置（详细）
# ================================
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=20
DB_CONNECT_TIMEOUT=60
DB_READ_TIMEOUT=30
DB_WRITE_TIMEOUT=30

# ================================
# 训练任务配置
# ================================
MIN_AUDIO_SAMPLES=3
MIN_TRAINING_DURATION=30
MIN_TRAINING_DURATION_TEST=10
MAX_TRAINING_DURATION=600
DEFAULT_AUDIO_DURATION=5.0

# 任务时间估算配置
VOICE_CLONE_BASE_TIME=120
TTS_BASE_TIME=10
VOICE_CLONE_SAMPLE_FACTOR=30
VOICE_CLONE_DURATION_FACTOR=2
TTS_LENGTH_FACTOR=0.2
TTS_MIN_TIME=5

# 任务清理配置
TASK_CLEANUP_DAYS=30
TASK_STATS_PERIOD_DAYS=30

# ================================
# 文件处理配置
# ================================
FILE_HASH_ALGORITHM=sha256
FILE_HASH_CHUNK_SIZE=4096
FILE_SIZE_BINARY=true
MAX_FILENAME_LENGTH=255
DEFAULT_FILENAME_PREFIX=file

# 上传目录映射
UPLOAD_DIR_MODE=755

# ================================
# 安全和隐私配置
# ================================
PROXY_HEADERS=HTTP_X_FORWARDED_FOR,HTTP_X_REAL_IP,HTTP_CF_CONNECTING_IP
USER_AGENT_MAX_LENGTH=500
MASK_CHARACTER=*
SENSITIVE_FIELDS=password,token,key,secret,email

# ================================
# API配置
# ================================
API_VERSION=1.0
API_KEY_LENGTH=32
API_KEY_PREFIX=sk
DEFAULT_RATE_LIMIT=60
MAX_ITEMS_PER_PAGE=100

# ================================
# 响应格式配置
# ================================
RESPONSE_INCLUDE_TIMESTAMP=false
RESPONSE_INCLUDE_VERSION=false

# ================================
# 日志配置（详细）
# ================================
ENABLE_ACTION_LOGGING=true
ACTION_LOG_LEVEL=INFO
SQLALCHEMY_ECHO=false

# ================================
# 系统监控配置
# ================================
SYSTEM_INFO_LEVEL=basic
MIN_DISK_SPACE_MB=1024

# ================================
# 清理配置
# ================================
TEMP_FILE_MAX_AGE_HOURS=24
TEMP_CLEANUP_MODE=recursive

# ================================
# 输入验证配置
# ================================
MAX_USER_INPUT_LENGTH=1000
INPUT_VALIDATION_MODE=strict

# ================================
# 时间格式配置
# ================================
DURATION_SHOW_SECONDS=true

# ================================
# 文件URL配置
# ================================
FILE_BASE_URL=/uploads